 1472          SS   8\
 1474done      BSS  snapsh,C\
 1479          SBR  clearl&3,gmwm\
 1486          LCA  gaux1,phasid\
 1493          B    loadnx\
 1497print     WP   lastcd\
     *\
     * Data\
     *\
 1503usrbas    DSA  fmtbaa         Base address of user code\
 1521setwms    DCW  @,040040,0400401040@\
 1522flag      dc   #1\
 1525a146      DSA  146\
 1526lca       LCA\
 1529a001      DSA  1\
 1530k1        dcw  1\
 1531w1        DCW  #1\
 1538w7        DCW  #7\
 1541a040      DSA  40\
 1544a160      DSA  160\
 1547km990     dcw  -990\
 1550a000      DSA  0\
 1551cw        CW\
 1554a153      DSA  153\
 1557a167      DSA  167\
 1560a080      DSA  80\
 1561cs        CS\
 1569gaux1     DCW  @GAUX ONE@\
 1572          DSA  3999\
 1573gmwm      DCW  @\}@\
               ex   beginn\
               END\
