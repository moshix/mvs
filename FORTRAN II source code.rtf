     * Reload the snapshot phase 53S\
     *\
 1000begin1    SBR  tpread&6,snapsh\
 1007          SBR  clrbot,begin1\
 1014          SBR  loadxx&3,begin2\
 1021          SBR  clearl&3,gmwm\
 1028          LCA  snap53,phasid\
 1035          B    loadnx\
 1048snap53    DCW  @SNAPSHOT53@\
               ORG  1696\
 1696gmwm      DCW  @\}@\
               ex   beginn\
               END\
